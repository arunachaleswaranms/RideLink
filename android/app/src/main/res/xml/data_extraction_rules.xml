<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing RideLink stores leaves the phone: not to a cloud backup, and not to a new phone during
    device-to-device setup. `android:allowBackup="false"` alone no longer covers the second case for
    targetSdk 31+; only these rules do.

    Why it matters rather than being tidy: the identity key lives in Android Keystore and is never
    migrated, but `files/security/peer_id` and `trusted_peers.json` would be. A migrated phone would
    then present the old `peer_id` with a new `identity_spki_sha256`, which the pillion's phone
    correctly refuses as an identity change, and the imported library's SAF grants would not carry
    over either. A new phone should simply pair fresh.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
